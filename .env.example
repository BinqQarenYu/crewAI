# CrewAI Studio — Standalone Environment Variables Template
# Copy this file to .env (or let start.bat create .env automatically)

PORT=3000

# Primary & Multi-Slot Gemini API Keys (Rotated automatically by Quota Governor)
GEMINI_API_KEY=
GEMINI_API_KEY_0=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# GitHub Personal Access Token (Classic ghp_... or Fine-Grained github_pat_...)
GITHUB_TOKEN=

# Optional Additional LLM Providers & Local Ollama Pool
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Optional Google Jules Cloud VM API Key
JULES_API_KEY=
